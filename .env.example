# Copy this file to .env and fill in your own values. Never commit .env itself.
#
#   cp .env.example .env
#
# Syntax: KEY=value, one per line. Quotes are optional but safest for values
# containing spaces or parentheses — python-dotenv strips the surrounding pair.
# A value already exported in your shell takes precedence over the one here.

# MusicBrainz: no API key needed, but the API does require a User-Agent that
# names your application and gives them a contact route if it misbehaves.
# Requests with a generic or absent User-Agent get throttled or blocked.
# A repo URL counts as contact info, so you don't have to publish your email.
# Format: app-name/version ( contact )
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MB_USER_AGENT="dragonforce-analysis/0.1 ( https://github.com/ahappyshark/python-dragonforce )"

# Spotify: create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius: create an app at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=
